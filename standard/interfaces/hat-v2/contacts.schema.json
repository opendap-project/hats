{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/opendap-project/hat-standard/blob/main/interfaces/hat-v2/contacts.schema.json",
  "title": "opendap.hat-contacts/v1: the HAT interface v2 contact field, its functions, electrical classes and pogo positions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "interface",
    "revision",
    "status",
    "function",
    "field"
  ],
  "properties": {
    "schema": {
      "const": "opendap.hat-contacts/v1"
    },
    "interface": {
      "const": "hat-v2"
    },
    "revision": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "accepted",
        "superseded",
        "withdrawn"
      ]
    },
    "function": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "signals",
          "pins"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "enum": [
                    "out",
                    "in"
                  ],
                  "description": "out = device to HAT, in = HAT to device"
                }
              }
            }
          },
          "pins": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "the contact names this function takes in the field"
          },
          "pairs": {
            "type": "integer",
            "minimum": 1,
            "description": "differential pairs among its contacts"
          },
          "electrical_class": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pitch_mm",
        "columns",
        "row"
      ],
      "properties": {
        "pitch_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "row": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "contacts"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z]$"
              },
              "contacts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
